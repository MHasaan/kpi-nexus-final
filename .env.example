# =========================================================================
# KPI Nexus — root environment template.
#
# Copy to `.env` for tooling that reads from the root (scripts/setup-db.mjs,
# Prisma CLI, etc.). Each app also has its own apps/*/.env.example with
# the subset it actually consumes.
# =========================================================================

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql://kpi_nexus:dev_password@localhost:5432/kpi_nexus

# ---- Redis (cache + BullMQ broker) ---------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, S3 in prod) --------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kpi-nexus-local
S3_REGION=us-east-1

# ---- Email (Mailhog catches everything locally) --------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KPI Nexus <noreply@kpi-nexus.local>"

# ---- Observability -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
LOG_LEVEL=debug

# ---- API (apps/api) ------------------------------------------------------
API_PORT=4000
JWT_SECRET=dev-jwt-secret-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Web (apps/web) ------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- ML sidecar (apps/ml) ------------------------------------------------
ML_SIDECAR_URL=http://localhost:8000
ML_SIDECAR_PORT=8000
ML_SIDECAR_HMAC_SECRET=dev-ml-shared-secret

# ---- AI providers (BYO in dev; platform keys in prod) --------------------
# Comma-separated key pool — first available used; rotated on rate-limit.
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default provider order (comma-separated): used when an org has no preference
AI_PROVIDER_ORDER=gemini,anthropic,openai,ollama

# 32-byte secret used to encrypt BYO keys at rest. Replace before prod.
BYO_ENCRYPTION_KEY=dev-encryption-key-32-bytes-long-replace

# Per-org defaults — overridable via org settings
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=30

# ---- Node / runtime ------------------------------------------------------
NODE_ENV=development
