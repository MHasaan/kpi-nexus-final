# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Database (Postgres + TimescaleDB)
DATABASE_URL=postgresql://kpi_nexus:dev_password@127.0.0.1:5432/kpi_nexus

# Row-level security (OT-014). DATABASE_URL is the OWNER role — migrations,
# setup-db and the seed only. With RLS_ENFORCED=true the API serves requests as
# kpi_app (no bypass; org set per transaction) and runs system work
# (pre-login lookups, background jobs) as kpi_system. setup-db.mjs creates both
# roles and sets their passwords from KPI_*_DB_PASSWORD (dev defaults below —
# use real secrets anywhere else).
RLS_ENFORCED=true
DATABASE_URL_APP=postgresql://kpi_app:app_password@127.0.0.1:5432/kpi_nexus
DATABASE_URL_SYSTEM=postgresql://kpi_system:system_password@127.0.0.1:5432/kpi_nexus
KPI_APP_DB_PASSWORD=app_password
KPI_SYSTEM_DB_PASSWORD=system_password

# Redis (cache + queues)
REDIS_URL=redis://127.0.0.1:6379

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
SENTRY_DSN=

# Auth (placeholder — populated in P1)
JWT_SECRET=dev-jwt-secret-change-in-prod
# In production (NODE_ENV=production) the API refuses to boot unless these are
# real secrets: at least 32 chars and not the dev defaults shown here (OT-008):
# JWT_SECRET, ML_SIDECAR_HMAC_SECRET, EMBED_TOKEN_SECRET, plus
# NOTIFICATION_ENCRYPTION_KEY (falls back to BYO_ENCRYPTION_KEY) and
# ONBOARDING_DRAFT_SECRET (falls back to JWT_SECRET).
# NOTIFICATION_ENCRYPTION_KEY=
# ONBOARDING_DRAFT_SECRET=


# ML sidecar (placeholder — wired in P5)
ML_SIDECAR_URL=http://127.0.0.1:8000
ML_SIDECAR_HMAC_SECRET=dev-ml-shared-secret

# Reports (P3.6) — KPI embed token HMAC secret
EMBED_TOKEN_SECRET=dev-embed-secret-change-me-in-prod

# Encryption keys at rest. Unset uses dev-only keys; production refuses to boot
# without real ones. 64 hex chars each, e.g. `openssl rand -hex 32`.
# BYO_ENCRYPTION_KEY: AI provider keys that orgs bring themselves.
# INTEGRATION_CRYPTO_KEY: Slack/Teams/Jira/connector tokens.
# BYO_ENCRYPTION_KEY=
INTEGRATION_CRYPTO_KEY=

# Public URL of the web app — used for links in emails (password reset, invites).
WEB_APP_URL=http://localhost:3000

# Outbound SSRF guard: comma-separated hosts/IPs that tenant webhooks, channels
# and connectors MAY reach even though they are internal (default: none).
OUTBOUND_ALLOWED_HOSTS=

# Reverse proxy trust for client IPs (X-Forwarded-For). Set as a REAL environment
# variable on the API process (not read from .env). Unset = direct exposure,
# XFF ignored. Behind one load balancer: TRUST_PROXY=1. Or a CIDR list.
# TRUST_PROXY=1

# Rate limiting is ON by default (set RATE_LIMIT_ENABLED=false to disable).
# Budgets (defaults shown): per-IP on /auth/*, per-account on login (per 15 min),
# per signed-in user / API key (per-IP without a login) on everything else, per-IP on the public
# onboarding start/AI routes, plus a global daily cap on onboarding LLM calls.
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_LOGIN_PER_ACCOUNT=20
# RATE_LIMIT_USER_PER_MIN=600   # per signed-in user / API key (old name: RATE_LIMIT_ORG_PER_MIN)
# RATE_LIMIT_ANON_PER_MIN=300   # per IP, requests without a login
# RATE_LIMIT_ONBOARDING_START_PER_HOUR=10
# RATE_LIMIT_ONBOARDING_AI_PER_HOUR=30
# RATE_LIMIT_ONBOARDING_AI_GLOBAL_PER_DAY=500

# Platform admins are global operators. The first one comes from the seed (or a
# direct DB grant). Set to true ONLY on a fresh install to let the first caller of
# POST /platform/admins grant it while none exist; anyone can register an org, so
# leave it unset otherwise.
# PLATFORM_ADMIN_BOOTSTRAP_OPEN=true
