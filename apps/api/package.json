{
  "name": "@kpi-nexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "start:prod": "NODE_ENV=production node --import ./dist/instrumentation.js dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:prod": "NODE_ENV=production node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:fresh-db": "vitest run --config vitest.fresh-db.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@kpi-nexus/ai": "workspace:*",
    "@kpi-nexus/contracts": "workspace:*",
    "@kpi-nexus/db": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.2.7",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/instrumentation": "6.19.3",
    "@sentry/node": "^11.12.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^10.5.0",
    "papaparse": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^7.30.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kpi-nexus/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.6",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0",
    "yaml": "^2.9.1"
  }
}
