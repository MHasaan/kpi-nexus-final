# /srv/kpi-nexus/.env on the Azure VM: compose variables (mode 600, never in
# git). provision.sh writes it with fresh random secrets; the values below are
# the shape only.
REGISTRY=local
IMAGE_TAG=demo
DB_IMAGE_TAG=demo
API_DOMAIN=kpinexus-demo.austriaeast.cloudapp.azure.com
# sslip.io turns the VM's IP into a name, so the S3 store gets a certificate without a DNS account.
S3_DOMAIN=s3.68-210-149-147.sslip.io
POSTGRES_PASSWORD=
KPI_OWNER_DB_PASSWORD=
KPI_APP_DB_PASSWORD=
KPI_SYSTEM_DB_PASSWORD=
REDIS_PASSWORD=
ML_SIDECAR_HMAC_SECRET=
# Sign-in for …/mail: a user name and a Caddy bcrypt hash (`caddy hash-password`).
MAIL_USER=admin
MAIL_HASH=
# Real outgoing mail: configure-mail.sh sets both (relay.yml inside the Mailpit container, forwarding on).
MAIL_RELAY_CONFIG=
MAIL_RELAY_ALL=false
