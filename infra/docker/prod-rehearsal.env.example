# Secrets for infra/docker/prod-rehearsal.compose.yml. Copy to
# prod-rehearsal.env (git-ignored) and fill every value. To generate them all:
#   for k in POSTGRES_PASSWORD KPI_OWNER_DB_PASSWORD KPI_APP_DB_PASSWORD \
#     KPI_SYSTEM_DB_PASSWORD JWT_SECRET ONBOARDING_DRAFT_SECRET \
#     NOTIFICATION_ENCRYPTION_KEY EMBED_TOKEN_SECRET ML_SIDECAR_HMAC_SECRET \
#     BYO_ENCRYPTION_KEY INTEGRATION_CRYPTO_KEY; do
#     echo "$k=$(openssl rand -hex 32)"; done > infra/docker/prod-rehearsal.env
POSTGRES_PASSWORD=
KPI_OWNER_DB_PASSWORD=
KPI_APP_DB_PASSWORD=
KPI_SYSTEM_DB_PASSWORD=
JWT_SECRET=
ONBOARDING_DRAFT_SECRET=
NOTIFICATION_ENCRYPTION_KEY=
EMBED_TOKEN_SECRET=
ML_SIDECAR_HMAC_SECRET=
BYO_ENCRYPTION_KEY=
INTEGRATION_CRYPTO_KEY=

# Only for running the test suites against the rehearsal (see CI for values):
# AI_MOCK=1
# AI_MOCK_RESPONSE=<one-line JSON from apps/api/test/fixtures/ai-mock-response.json>
# RATE_LIMIT_AUTH_PER_MIN=1000
# RATE_LIMIT_USER_PER_MIN=100000
# RATE_LIMIT_ANON_PER_MIN=100000
# RATE_LIMIT_LOGIN_PER_ACCOUNT=100
# RATE_LIMIT_ONBOARDING_START_PER_HOUR=1000
# RATE_LIMIT_ONBOARDING_AI_PER_HOUR=1000
