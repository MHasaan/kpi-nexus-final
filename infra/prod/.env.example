# Compose variables for infra/prod/docker-compose.yml. On the VM this file is
# /srv/kpi-nexus/.env (mode 600, never in git). Every secret is 64 hex
# characters; they go into connection URLs, so keep them hex. Generate them with:
#   for k in POSTGRES_PASSWORD KPI_OWNER_DB_PASSWORD KPI_APP_DB_PASSWORD \
#     KPI_SYSTEM_DB_PASSWORD REDIS_PASSWORD ML_SIDECAR_HMAC_SECRET \
#     BACKUP_PASSPHRASE; do echo "$k=$(openssl rand -hex 32)"; done

# Set by the deploy; the values here are only for a manual start.
IMAGE_TAG=
DB_IMAGE_TAG=
# REGISTRY=ghcr.io/mhasaan

# The DuckDNS name, e.g. kpinexus-api.duckdns.org.
API_DOMAIN=

# Superuser: first boot and break-glass only; never given to the app.
POSTGRES_PASSWORD=
KPI_OWNER_DB_PASSWORD=
KPI_APP_DB_PASSWORD=
KPI_SYSTEM_DB_PASSWORD=
REDIS_PASSWORD=
ML_SIDECAR_HMAC_SECRET=

# Nightly backups (backup.sh) to Oracle Object Storage. Keep BACKUP_PASSPHRASE
# somewhere off the VM too: without it the backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
