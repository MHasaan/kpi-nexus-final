# API + worker settings for infra/prod/docker-compose.yml. On the VM this file
# is /srv/kpi-nexus/app.env (mode 600, never in git). Database, Redis and ML
# settings come from .env. Production refuses to start with a missing, default
# or short value for the first five (apps/api/src/config/secrets.ts). Generate:
#   for k in JWT_SECRET ONBOARDING_DRAFT_SECRET NOTIFICATION_ENCRYPTION_KEY \
#     EMBED_TOKEN_SECRET BYO_ENCRYPTION_KEY INTEGRATION_CRYPTO_KEY; do
#     echo "$k=$(openssl rand -hex 32)"; done
JWT_SECRET=
ONBOARDING_DRAFT_SECRET=
NOTIFICATION_ENCRYPTION_KEY=
EMBED_TOKEN_SECRET=
BYO_ENCRYPTION_KEY=
INTEGRATION_CRYPTO_KEY=

# The Vercel URL: links in emails, and the only allowed browser origin.
WEB_APP_URL=https://kpi-nexus.vercel.app
CORS_ALLOWED_ORIGINS=https://kpi-nexus.vercel.app

# Oracle Object Storage, S3-compatible API (a Customer Secret Key):
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Brevo SMTP (free, 300 emails a day), TLS on port 465. The sender must be verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KPI Nexus <noreply@example.com>

# Optional
# GEMINI_API_KEYS=
# SENTRY_DSN=
