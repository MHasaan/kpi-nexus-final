# API + worker settings for the local rehearsal. Copy to rehearsal.app.env
# (git-ignored) and generate the secrets with:
#   for k in JWT_SECRET ONBOARDING_DRAFT_SECRET NOTIFICATION_ENCRYPTION_KEY \
#     EMBED_TOKEN_SECRET BYO_ENCRYPTION_KEY INTEGRATION_CRYPTO_KEY; do
#     echo "$k=$(openssl rand -hex 32)"; done >> rehearsal.app.env
WEB_APP_URL=http://localhost:3400
CORS_ALLOWED_ORIGINS=http://localhost:3400,http://127.0.0.1:3400
S3_ENDPOINT=http://172.17.0.1:39000
S3_REGION=us-east-1
S3_BUCKET=kpi-nexus-local
S3_ACCESS_KEY=kpinexus
S3_SECRET_KEY=kpinexus-dev-secret
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=KPI Nexus <noreply@kpi-nexus.local>

# Only for running the test suites against the rehearsal (see CI for values):
# AI_MOCK=1
# AI_MOCK_RESPONSE=<one-line JSON from apps/api/test/fixtures/ai-mock-response.json>
# RATE_LIMIT_AUTH_PER_MIN=1000
# RATE_LIMIT_USER_PER_MIN=100000
# RATE_LIMIT_ANON_PER_MIN=100000
# RATE_LIMIT_LOGIN_PER_ACCOUNT=100
# RATE_LIMIT_ONBOARDING_START_PER_HOUR=1000
# RATE_LIMIT_ONBOARDING_AI_PER_HOUR=1000

JWT_SECRET=
ONBOARDING_DRAFT_SECRET=
NOTIFICATION_ENCRYPTION_KEY=
EMBED_TOKEN_SECRET=
BYO_ENCRYPTION_KEY=
INTEGRATION_CRYPTO_KEY=
