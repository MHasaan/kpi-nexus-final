# Compose variables for the local rehearsal (rehearsal.override.yml). Copy to
# rehearsal.env (git-ignored). Generate the secrets with:
#   for k in POSTGRES_PASSWORD KPI_OWNER_DB_PASSWORD KPI_APP_DB_PASSWORD \
#     KPI_SYSTEM_DB_PASSWORD REDIS_PASSWORD ML_SIDECAR_HMAC_SECRET \
#     BACKUP_PASSPHRASE; do echo "$k=$(openssl rand -hex 32)"; done >> rehearsal.env
REGISTRY=local
IMAGE_TAG=rehearsal
DB_IMAGE_TAG=rehearsal
API_DOMAIN=api.kpi-nexus.localhost
CADDY_TLS=tls internal

# backup.sh / restore.sh read .env; for the rehearsal, link it: ln -s rehearsal.env .env
BACKUP_S3_ENDPOINT=http://127.0.0.1:39000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=kpi-nexus-local
BACKUP_S3_ACCESS_KEY=kpinexus
BACKUP_S3_SECRET_KEY=kpinexus-dev-secret

POSTGRES_PASSWORD=
KPI_OWNER_DB_PASSWORD=
KPI_APP_DB_PASSWORD=
KPI_SYSTEM_DB_PASSWORD=
REDIS_PASSWORD=
ML_SIDECAR_HMAC_SECRET=
BACKUP_PASSPHRASE=
