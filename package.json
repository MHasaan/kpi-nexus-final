{
  "name": "kpi-nexus-final",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:int": "turbo test:int",
    "test:e2e": "turbo test:e2e",
    "db:setup": "node --env-file=.env scripts/setup-db.mjs",
    "db:migrate": "pnpm --filter @kpi-nexus/db exec prisma migrate dev",
    "db:generate": "pnpm --filter @kpi-nexus/db exec prisma generate",
    "db:studio": "pnpm --filter @kpi-nexus/db exec prisma studio",
    "db:reset": "pnpm --filter @kpi-nexus/db exec prisma migrate reset --force",
    "bench:hypertable": "node --env-file=.env scripts/bench-hypertable.mjs",
    "ml:dev": "cd apps/ml && uvicorn app.main:app --reload --port 8000",
    "ml:test": "cd apps/ml && pytest",
    "ml:install": "pip install -r apps/ml/requirements.txt",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f infra/docker/docker-compose.yml ps"
  },
  "devDependencies": {
    "pg": "^8.13.0",
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "//": "Security pins for transitive deps (audit OT-013). Each stays within the range its parent supports; drop a pin once the parent ships the patched version.",
    "overrides": {
      "fastify": "^5.12.8",
      "find-my-way": "^9.7.0",
      "fast-uri": "^3.1.9",
      "@grpc/grpc-js": "^1.14.5",
      "postcss": "^8.5.18",
      "nanoid@^3": "^3.3.18",
      "browserslist": "^4.28.7",
      "sharp": "^0.35.5",
      "brace-expansion@^2": "^2.1.2",
      "brace-expansion@^1": "^1.1.20"
    }
  }
}
