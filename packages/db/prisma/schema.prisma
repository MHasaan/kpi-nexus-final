// KPI Nexus database schema.
//
// P1: Identity + Tenancy + RBAC + Org Structure + Audit/Billing/Governance.
// All P1 models below are landed as a single consolidated migration
// (`p1_identity_tenancy_rbac`) — the spec's separate 001..004 migrations
// are merged because this is the first schema migration and the prod
// system has no users yet.
//
// See docs/superpowers/specs/2026-05-25-kpi-nexus-final-design.md (§3, §5)
// and docs/superpowers/plans/P1-identity-tenancy-rbac.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [timescaledb, pgvector(map: "vector")]
}

// ============================================================================
// Enums
// ============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
  PURGED
}

enum OrgSizeTier {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum DataResidency {
  US
  EU
  APAC
  OTHER
}

enum UserStatus {
  INVITED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
  PURGED
}

enum LoginAttemptStatus {
  SUCCESS
  INVALID_CREDENTIALS
  USER_NOT_FOUND
  USER_INACTIVE
  MFA_REQUIRED
  MFA_FAILED
}

enum PositionTrack {
  IC
  MANAGEMENT
  EXECUTIVE
}

enum ResourceSubjectType {
  user
  role
}

enum OrgUnitStatus {
  PLANNED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OrgUnitMemberRole {
  MEMBER
  MANAGER
  LEAD
  DEPUTY
}

enum OrgUnitLeaveReason {
  TRANSFERRED
  PROMOTED
  LEFT_ORG
  STRUCTURE_CHANGE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  IMPERSONATE_START
  IMPERSONATE_END
  APPROVE
  REJECT
}

// ============================================================================
// Identity + Tenancy
// ============================================================================

model Organization {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  tenantStatus        TenantStatus  @default(TRIAL)
  sizeTier            OrgSizeTier?
  industry            String?
  type                String?
  // Branding
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String?
  secondaryColor      String?
  // Locale + fiscal
  timezone            String        @default("UTC")
  currency            String        @default("USD")
  locale              String        @default("en-US")
  supportedTimezones  String[]
  supportedCurrencies String[]
  supportedLocales    String[]
  dateFormat          String        @default("YYYY-MM-DD")
  numberFormat        String        @default("en-US")
  weekStartsOn        Int           @default(0)
  fiscalCalendar      Json?
  // Terminology — 8 customizable labels surfaced in UI
  roleLabel           String        @default("Role")
  groupLabel          String        @default("Team")
  memberLabel         String        @default("Member")
  kpiLabel            String        @default("KPI")
  dashboardLabel      String        @default("Dashboard")
  scorecardLabel      String        @default("Scorecard")
  objectiveLabel      String        @default("Objective")
  taskLabel           String        @default("Task")
  // Optional plural overrides (null → the UI auto-pluralizes the singular label)
  roleLabelPlural      String?
  groupLabelPlural     String?
  memberLabelPlural    String?
  kpiLabelPlural       String?
  dashboardLabelPlural String?
  scorecardLabelPlural String?
  objectiveLabelPlural String?
  taskLabelPlural      String?
  // Compliance
  dataResidency       DataResidency @default(US)
  complianceProfile   String[]
  // Per-org user custom field schema
  userCustomFieldDefs Json?
  // Per-org password policy override
  passwordPolicy      Json?
  // Billing
  planKey             String        @default("ENTERPRISE")
  planStartedAt       DateTime?
  planExpiresAt       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  users                 User[]
  customDomains         CustomDomain[]
  roleDefinitions       RoleDefinition[]
  roleInheritances      RoleInheritance[]
  positions             Position[]
  permissionDelegations PermissionDelegation[]
  accessOverrides       UserAccessOverride[]
  resourcePermissions   ResourcePermission[]
  orgUnitDimensions     OrgUnitDimension[]
  orgUnitTypes          OrgUnitType[]
  orgUnits              OrgUnit[]
  orgUnitMembers        OrgUnitMember[]
  auditLogs             AuditLog[]
  tenantQuotas          TenantQuota[]
  featureFlags          FeatureFlag[]
  costMetrics           CostMetric[]
  retentionPolicies     RetentionPolicy[]
  kpiCategories         KPICategory[]
  kpis                  KPI[]
  kpiDataPoints         KPIDataPoint[]
  dashboards            Dashboard[]
  dashboardWidgets      DashboardWidget[]
  dashboardSnapshots    DashboardSnapshot[]
  dashboardShareLinks   DashboardShareLink[]
  dashboardUnitAssignments DashboardAssignmentOrgUnit[]
  scheduledReports      ScheduledReport[]
  reportRuns            ReportRun[]
  alertRules            AlertRule[]
  escalationRules       EscalationRule[]
  alerts                Alert[]
  notificationChannels  NotificationChannel[]
  notificationDeliveries NotificationDelivery[]
  webhookSubscriptions  WebhookSubscription[]
  apiKeys               ApiKey[]

  @@index([tenantStatus])
}

model CustomDomain {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain            String       @unique
  txtChallengeKey   String
  txtChallengeValue String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  lastCheckError    String?
  createdAt         DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                 String
  emailVerifiedAt       DateTime?
  fullName              String
  passwordHash          String?
  status                UserStatus      @default(ACTIVE)
  // Optional profile fields
  avatarUrl             String?
  phone                 String?
  secondaryEmail        String?
  language              String?
  timezone              String?
  customFields          Json?
  // RBAC + org structure linkage
  roleId                String?
  role                  RoleDefinition? @relation(fields: [roleId], references: [id])
  managerId             String?
  manager               User?           @relation("UserManager", fields: [managerId], references: [id])
  directReports         User[]          @relation("UserManager")
  positionId            String?
  position              Position?       @relation(fields: [positionId], references: [id])
  // MFA
  mfaEnabled            Boolean         @default(false)
  mfaSecret             String?
  mfaPendingSecret      String?
  mfaRecoveryHashes     String[]
  // Onboarding + preferences
  onboardingCompletedAt DateTime?
  notificationSettings  Json?
  // Lifecycle
  isActive              Boolean         @default(true)
  invitedAt             DateTime?
  invitedById           String?
  invitedBy             User?           @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitedUsers          User[]          @relation("UserInvitedBy")
  archivedAt            DateTime?
  archivedById          String?
  archivedBy            User?           @relation("UserArchivedBy", fields: [archivedById], references: [id])
  archivedUsers         User[]          @relation("UserArchivedBy")
  purgedAt              DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  refreshTokens         RefreshToken[]
  platformAdmin         PlatformAdmin?
  accessOverrides       UserAccessOverride[]
  orgUnitMemberships    OrgUnitMember[]
  headedOrgUnits        OrgUnit[]           @relation("OrgUnitHead")
  ownedKpis             KPI[]               @relation("KpiOwner")
  createdKpis           KPI[]               @relation("KpiCreatedBy")
  kpiAssignments        KPIAssignmentUser[] @relation("UserKpiAssignments")
  kpiDataPoints         KPIDataPoint[]      @relation("UserKpiDataPoints")
  kpiDataPointsRecorded KPIDataPoint[]      @relation("UserKpiDataPointsRecorded")
  ownedDashboards              Dashboard[]           @relation("DashboardOwner")
  dashboardSnapshotsTaken      DashboardSnapshot[]   @relation("DashboardSnapshotTakenBy")
  dashboardShareLinksCreated   DashboardShareLink[]  @relation("DashboardShareLinkCreatedBy")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([roleId])
  @@index([managerId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken  String    @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id             String             @id @default(cuid())
  email          String
  organizationId String?
  userId         String?
  status         LoginAttemptStatus
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime           @default(now())

  @@index([email, createdAt])
  @@index([organizationId, status, createdAt])
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())
  grantedBy String
}

// ============================================================================
// RBAC
// ============================================================================

model RoleDefinition {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  // PermissionKey enum values from packages/contracts/src/permissions.ts
  permissions      String[]
  isAdmin          Boolean      @default(false)
  level            Int          @default(0)
  color            String?
  canAccessModules String[]
  // Layer-2 granular access: partial Domain→Scope map (Zod ScopeConfig in contracts).
  // null/absent ⇒ derived default (UNITS for non-admins) ⇒ behavioural parity.
  scopeConfig      Json?
  // Layer-3 granular access: KPI category allowlist (Zod DataTypeConfig in contracts).
  // null/absent ⇒ all categories ⇒ parity. Enforced in the KPI visibility builder.
  dataTypeConfig   Json?
  // Layer-4 granular access: data limits (Zod DataLimitsConfig in contracts) —
  // historyWindowDays / maxListRows / maxExportRows. null ⇒ unlimited ⇒ parity.
  dataLimits       Json?
  // Layer-5 granular access: page-access allow/deny lists (Zod PageAccessConfig in
  // contracts). null/absent ⇒ no restriction ⇒ parity. Resolved onto the AccessProfile.
  pageAccess       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users       User[]
  parentEdges RoleInheritance[] @relation("RoleParentEdge")
  childEdges  RoleInheritance[] @relation("RoleChildEdge")

  @@unique([organizationId, name])
}

model RoleInheritance {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentRoleId        String
  parentRole          RoleDefinition @relation("RoleParentEdge", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRoleId         String
  childRole           RoleDefinition @relation("RoleChildEdge", fields: [childRoleId], references: [id], onDelete: Cascade)
  inheritsPermissions Boolean        @default(true)
  createdAt           DateTime       @default(now())

  @@unique([parentRoleId, childRoleId])
  @@index([childRoleId])
  @@index([organizationId])
}

model Position {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  level          Int            @default(0)
  track          PositionTrack?
  payGrade       String?
  description    String?
  orgUnitId      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users User[]

  @@unique([organizationId, name])
}

model PermissionDelegation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantorUserId  String
  granteeUserId  String
  // empty array = inherit ALL of grantor's permissions during the window
  permissions    String[]
  reason         String?
  validFrom      DateTime
  validTo        DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([granteeUserId, validFrom, validTo])
}

model ResourcePermission {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType    ResourceSubjectType
  subjectId      String
  action         String
  resourceType   String
  resourceId     String
  grantedById    String
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())

  @@unique([organizationId, subjectType, subjectId, action, resourceType, resourceId])
  @@index([subjectType, subjectId])
}

// Granular access Phase 5: per-user override on top of the role. One row per user.
// Capabilities are grant/revoke deltas (applied in PermissionResolverService so the
// guard honours them); scope/dataType/limits REPLACE the role value per-field when set
// (applied in AccessContextService). null/absent ⇒ role value ⇒ parity. Admins are immune.
// Zod UserAccessOverride in contracts.
model UserAccessOverride {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantCapabilities  String[]
  revokeCapabilities String[]
  scopeConfig        Json?
  dataTypeConfig     Json?
  dataLimits         Json?
  // Layer-5 page-access override (Zod PageAccessConfig). When set, REPLACES the role's
  // pageAccess wholesale (applied in AccessContextService). null/absent ⇒ role value.
  pageAccess         Json?
  updatedById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Composite unique ⇒ the upsert selector includes organizationId (DB-level tenant
  // safety, not guard-ordering). A user belongs to one org, so this is still ≤1 per user.
  @@unique([organizationId, userId])
  @@index([organizationId])
}

// ============================================================================
// Org Structure
// ============================================================================

model OrgUnitDimension {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  orgUnitTypes OrgUnitType[]

  @@unique([organizationId, name])
}

model OrgUnitType {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dimensionId          String?
  dimension            OrgUnitDimension? @relation(fields: [dimensionId], references: [id])
  name                 String
  namePlural           String
  icon                 String?
  color                String?
  allowNesting         Boolean           @default(true)
  maxDepth             Int?
  allowedParentTypeIds String[]
  sortOrder            Int               @default(0)
  createdAt            DateTime          @default(now())

  orgUnits OrgUnit[]

  @@unique([organizationId, name])
}

model OrgUnit {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnitTypeId      String
  orgUnitType        OrgUnitType   @relation(fields: [orgUnitTypeId], references: [id])
  parentUnitId       String?
  parentUnit         OrgUnit?      @relation("OrgUnitParent", fields: [parentUnitId], references: [id])
  children           OrgUnit[]     @relation("OrgUnitParent")
  name               String
  code               String?
  description        String?
  headUserId         String?
  headUser           User?         @relation("OrgUnitHead", fields: [headUserId], references: [id])
  status             OrgUnitStatus @default(ACTIVE)
  visibilityInherits Boolean       @default(true)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  metadata           Json?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  members        OrgUnitMember[]
  nameHistory    OrgUnitNameHistory[]
  kpiAssignments KPIAssignmentOrgUnit[]
  kpiDataPoints  KPIDataPoint[]         @relation("KpiDataPointOrgUnit")
  dashboardAssignments DashboardAssignmentOrgUnit[]

  @@index([organizationId, status])
  @@index([parentUnitId])
}

model OrgUnitMember {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnitId      String
  orgUnit        OrgUnit             @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRole     OrgUnitMemberRole   @default(MEMBER)
  joinedAt       DateTime            @default(now())
  leftAt         DateTime?
  leaveReason    OrgUnitLeaveReason?

  @@unique([orgUnitId, userId])
  @@index([orgUnitId, leftAt])
  @@index([userId])
}

model OrgUnitNameHistory {
  id           String   @id @default(cuid())
  orgUnitId    String
  orgUnit      OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  previousName String
  changedById  String
  changedAt    DateTime @default(now())

  @@index([orgUnitId, changedAt])
}

// ============================================================================
// Audit + Billing + Governance
// ============================================================================

model AuditLog {
  id             String        @id @default(cuid())
  // nullable for platform-admin cross-tenant ops
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         AuditAction
  entityType     String?
  entityId       String?
  changes        Json?
  userId         String?
  userEmail      String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  redactedKeys   String[]
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model Plan {
  id              String   @id @default(cuid())
  // FREE | PRO | ENTERPRISE
  key             String   @unique
  displayName     String
  monthlyPriceUsd Float    @default(0)
  annualPriceUsd  Float    @default(0)
  features        String[]
  quotas          Json
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
}

model TenantQuota {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  // 0 means unlimited
  limit          Int
  current        Int          @default(0)
  periodStart    DateTime
  periodEnd      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

model FeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  enabled        Boolean      @default(false)
  rolloutPercent Int?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
}

model CostMetric {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // UTC day start
  day             DateTime
  kpiCount        Int          @default(0)
  dataPointsToday Int          @default(0)
  alertsToday     Int          @default(0)
  aiInputTokens   Int          @default(0)
  aiOutputTokens  Int          @default(0)
  aiCostUsd       Float        @default(0)
  apiRequests     Int          @default(0)
  storageBytes    BigInt       @default(0)
  createdAt       DateTime     @default(now())

  @@unique([organizationId, day])
}

model RetentionPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  days           Int
  isActive       Boolean      @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, entityType])
}

// ============================================================================
// P2 — KPI engine (slice 1: core model + assignments + categories + versions)
// ============================================================================

enum KPIStatus {
  DRAFT
  PROPOSED
  APPROVED
  ACTIVE
  PAUSED
  DEPRECATED
  ARCHIVED
}

enum KPIScope {
  ORG_WIDE
  PER_UNIT
  PER_USER
}

enum KPIType {
  NUMBER
  PERCENTAGE
  CURRENCY
  DURATION
  COUNT
  RATING
  BOOLEAN
}

enum KPIDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  TARGET_IS_BEST
  NEUTRAL
}

enum KPIFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
  REAL_TIME
  AD_HOC
}

enum AggregationMethod {
  SUM
  AVG
  MIN
  MAX
  MEDIAN
  P25
  P75
  P90
  P95
  P99
  LAST
  FIRST
  COUNT
  COUNT_DISTINCT
  STDEV
}

model KPICategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  color          String?
  icon           String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  kpis KPI[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model KPI {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          KPICategory?      @relation(fields: [categoryId], references: [id])
  name              String
  description       String?
  unit              String?
  scope             KPIScope          @default(ORG_WIDE)
  type              KPIType           @default(NUMBER)
  direction         KPIDirection      @default(HIGHER_IS_BETTER)
  frequency         KPIFrequency      @default(MONTHLY)
  aggregationMethod AggregationMethod @default(LAST)
  status            KPIStatus         @default(DRAFT)
  // Bumped to revoke all previously-minted public embed tokens for this KPI.
  embedTokenVersion Int               @default(0)
  // Legacy single-target fields kept for simple cases — KPITarget model
  // (lands in P2.2) is the authoritative source for tiered/dynamic targets.
  targetValue       Float?
  warningThreshold  Float?
  criticalThreshold Float?
  allowNegative     Boolean           @default(false)
  // Balanced-scorecard quadrant (free string: FINANCIAL | CUSTOMER |
  // INTERNAL_PROCESS | LEARNING_GROWTH). Drives the /kpis/scorecard grid.
  scorecardQuadrant String?
  ownerUserId       String?
  owner             User?             @relation("KpiOwner", fields: [ownerUserId], references: [id])
  tags              String[]
  isActive          Boolean           @default(true)
  isArchived        Boolean           @default(false)
  // Optimistic concurrency. Bumps on every patch.
  version           Int               @default(1)
  // Soft delete — list endpoints filter deletedAt IS NULL.
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?
  createdBy         User?             @relation("KpiCreatedBy", fields: [createdById], references: [id])

  versions             KPIVersion[]
  orgUnitAssignments   KPIAssignmentOrgUnit[]
  userAssignments      KPIAssignmentUser[]
  dataPoints           KPIDataPoint[]
  cascadeAsParentEdges KPICascade[]           @relation("CascadeParent")
  cascadeAsChildEdges  KPICascade[]           @relation("CascadeChild")

  @@unique([organizationId, name])
  @@index([organizationId, status, deletedAt])
  @@index([categoryId])
  @@index([scope])
}

model KPIVersion {
  id          String   @id @default(cuid())
  kpiId       String
  kpi         KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([kpiId, version])
  @@index([kpiId])
}

// Assignment of a PER_UNIT KPI to a specific OrgUnit. Used by
// `buildKpiVisibilityWhere` to filter the list endpoint by orgUnit membership.
model KPIAssignmentOrgUnit {
  id                  String   @id @default(cuid())
  organizationId      String
  kpiId               String
  kpi                 KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  orgUnitId           String
  orgUnit             OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  // Inheritance: direct rows (inherited=false) cascade to descendants as
  // inherited rows (inherited=true, inheritedFromUnitId = nearest direct ancestor).
  inherited           Boolean  @default(false)
  inheritedFromUnitId String?
  targetValue         Float?
  currentValue        Float?
  status              String?
  createdAt           DateTime @default(now())

  @@unique([kpiId, orgUnitId])
  @@index([organizationId])
  @@index([orgUnitId])
}

// Assignment of a PER_USER KPI to a specific user (self-tracked metric).
model KPIAssignmentUser {
  id             String   @id @default(cuid())
  organizationId String
  kpiId          String
  kpi            KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("UserKpiAssignments", fields: [userId], references: [id], onDelete: Cascade)
  // Per-assignment goal + denormalized latest value/status (refreshed on record).
  targetValue    Float?
  currentValue   Float?
  status         String?  // on_track | at_risk | behind | exceeded (direction-aware)
  createdAt      DateTime @default(now())

  @@unique([kpiId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ============================================================================
// P2.2 — KPIDataPoint (TimescaleDB hypertable)
// ============================================================================

enum DataPointSourceType {
  MANUAL
  INGESTION
  COMPUTED
  INTEGRATION
}

enum DataPointQualityFlag {
  HIGH
  MEDIUM
  LOW
}

// Append-only time-series table. The composite primary key is
// (recordedAt, id) because TimescaleDB requires the time column to be part
// of any unique/primary constraint on a hypertable.
//
// The post-migration SQL in `packages/db/prisma/sql/hypertables.sql`
// converts the table to a hypertable partitioned on `recordedAt` with
// 7-day chunk_time_interval.
//
// Scope routing — every row carries the KPI's scope and EXACTLY ONE of
// orgUnitId/userId:
//   ORG_WIDE → both NULL
//   PER_UNIT → orgUnitId NOT NULL, userId NULL
//   PER_USER → userId NOT NULL, orgUnitId NULL
// This is enforced at the service layer; a Postgres CHECK constraint
// follows in P2.3.
model KPIDataPoint {
  id             String               @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kpiId          String
  kpi            KPI                  @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  // Scope-specific FKs (exactly one is non-null per row)
  orgUnitId      String?
  orgUnit        OrgUnit?             @relation("KpiDataPointOrgUnit", fields: [orgUnitId], references: [id])
  userId         String?
  user           User?                @relation("UserKpiDataPoints", fields: [userId], references: [id])
  // Value
  value          Float
  unit           String?
  // Period the value applies to (e.g. May 2026's revenue)
  periodStart    DateTime
  periodEnd      DateTime
  // When the data point was recorded
  recordedAt     DateTime             @default(now())
  recordedById   String?
  recordedBy     User?                @relation("UserKpiDataPointsRecorded", fields: [recordedById], references: [id])
  // Provenance
  sourceType     DataPointSourceType  @default(MANUAL)
  sourceRef      String?
  qualityFlag    DataPointQualityFlag @default(HIGH)
  note           String?
  metadata       Json?
  // Set by the Welford 3σ outlier detector at insert time (vs the KPI's recent history).
  isOutlier      Boolean              @default(false)

  @@id([recordedAt, id])
  @@index([organizationId, kpiId, periodStart])
  @@index([organizationId, orgUnitId, periodStart])
  @@index([organizationId, userId, periodStart])
}

// ============================================================================
// P2.4 — KPICascade (parent-child rollups)
// ============================================================================

enum RollupMethod {
  SUM
  AVG
  WEIGHTED_AVG
  MIN
  MAX
  CUSTOM_FORMULA
}

// Parent KPI rolled up from N children. Each row is one parent-child edge
// with an optional `weight` (used by WEIGHTED_AVG).
//
// The cascade is unique per (parentKpiId, childKpiId) — a child can
// contribute to multiple parents but each contribution is recorded once.
// `level` is informational for diamond-shaped cascades (BFS depth from
// the topmost root); it isn't enforced as a hierarchy constraint.
//
// `customFormula` is only used when method = CUSTOM_FORMULA. The formula
// is evaluated by the P2.3 evaluator with child KPI names as identifiers
// and their aggregated values as bindings.
model KPICascade {
  id              String       @id @default(cuid())
  organizationId  String
  parentKpiId     String
  parentKpi       KPI          @relation("CascadeParent", fields: [parentKpiId], references: [id], onDelete: Cascade)
  childKpiId      String
  childKpi        KPI          @relation("CascadeChild", fields: [childKpiId], references: [id], onDelete: Cascade)
  method          RollupMethod @default(SUM)
  weight          Float        @default(1.0)
  level           Int          @default(0)
  customFormula   String?
  // When the rollup last recomputed for this edge. Read-only audit metadata.
  lastComputedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([parentKpiId, childKpiId])
  @@index([organizationId])
  @@index([childKpiId])
}

// ============================================================================
// P3.2 — Dashboards + Widgets
// ============================================================================

// A user- or role-owned collection of widgets. Visibility:
//   - owner (ownerUserId) always sees it
//   - if isShared = true, every member of the org sees it
//   - admin always sees all
// `version` powers optimistic concurrency via If-Match ETag (W/"<version>").
// `deletedAt` powers soft delete; list endpoints filter deletedAt IS NULL.
model Dashboard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  ownerUserId    String?
  owner          User?        @relation("DashboardOwner", fields: [ownerUserId], references: [id])
  ownerRoleId    String?
  isShared       Boolean      @default(false)
  isDefault      Boolean      @default(false)
  layout         Json?
  version        Int          @default(1)
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  widgets    DashboardWidget[]
  snapshots  DashboardSnapshot[]
  shareLinks DashboardShareLink[]
  unitAssignments DashboardAssignmentOrgUnit[]

  @@index([organizationId, deletedAt])
  @@index([ownerUserId])
}

// Phase 2.5 — lets a dashboard be "published" to an org unit so unit members
// see it under UNITS scope. Additive; absence = today's owner/isShared model.
model DashboardAssignmentOrgUnit {
  id             String   @id @default(cuid())
  organizationId String
  dashboardId    String
  orgUnitId      String
  createdAt      DateTime @default(now())
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dashboard    Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  orgUnit      OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, orgUnitId])
  @@index([organizationId])
  @@index([orgUnitId])
}

// A single widget on a dashboard. `widgetType` is a string union enforced at
// the service layer (kpi_card | line | bar | pie | gauge | number | list |
// trend | activity | strategy_map). `config` holds per-type config
// (kpiId, color, axes, etc.). `position` is `{x, y, w, h}` on a 12-col grid.
model DashboardWidget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dashboardId    String
  dashboard      Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widgetType     String
  title          String?
  config         Json
  position       Json
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([dashboardId])
  @@index([organizationId])
}

// A frozen point-in-time snapshot of a dashboard + its widgets + latest KPI
// values for each referenced KPI. Created on demand; never mutated after
// creation. `payload` is a structured JSON blob (see SnapshotService.capture).
model DashboardSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dashboardId    String
  dashboard      Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  label          String?
  payload        Json
  takenById      String
  takenBy        User         @relation("DashboardSnapshotTakenBy", fields: [takenById], references: [id])
  takenAt        DateTime     @default(now())

  @@index([dashboardId, takenAt])
  @@index([organizationId])
}

// A tokenized public share link for a dashboard. Allows unauthenticated
// read-only access (optionally password-protected) without an account.
// `token` is globally unique (~43 chars base64url from 32 random bytes).
// Revocation is soft (revokedAt timestamp) to preserve audit trail.
model DashboardShareLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dashboardId    String
  dashboard      Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  token          String       @unique
  expiresAt      DateTime?
  viewCount      Int          @default(0)
  passwordHash   String?
  lastViewedAt   DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  createdById    String
  createdBy      User         @relation("DashboardShareLinkCreatedBy", fields: [createdById], references: [id])

  @@index([dashboardId, revokedAt])
  @@index([organizationId])
}

// ============================================================================
// P3.6 — Reports (ScheduledReport + ReportRun)
// ============================================================================

enum ReportRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReportFormat {
  CSV
  EXCEL
  PDF
}

// A recurring report configuration. The scheduler (P3.7) reads `cron` + `nextRunAt`
// to decide when to fire. `kpiIds` is a denormalised list — the generator
// resolves current KPI data at run time. `recipients` are email addresses.
model ScheduledReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  dashboardId    String?
  kpiIds         String[]
  cron           String
  format         ReportFormat
  recipients     String[]
  isActive       Boolean      @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String

  runs ReportRun[]

  @@index([organizationId, isActive])
}

// A single report generation run — produced either on-demand or by the scheduler.
// `fileUrl` is set only after SUCCEEDED; `error` is set only after FAILED.
// Scheduler (P3.7) uses `status = PENDING` rows to pick up work from BullMQ.
model ReportRun {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduledReportId String?
  scheduledReport   ScheduledReport? @relation(fields: [scheduledReportId], references: [id], onDelete: SetNull)
  triggeredById     String?
  status            ReportRunStatus  @default(PENDING)
  format            ReportFormat
  fileUrl           String?
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  ranAt             DateTime         @default(now())

  @@index([scheduledReportId, ranAt])
  @@index([organizationId])
}

// ============================================================================
// P4 — Alerting (rules, escalation, alerts, channels, deliveries, webhooks, api keys)
// ============================================================================

enum AlertRuleType {
  STATIC_THRESHOLD
  DYNAMIC_STDDEV
  RATE_OF_CHANGE
  NO_DATA
  COMPOSITE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum NotificationChannelKind {
  EMAIL
  SLACK
  TEAMS
  SMS
  IN_APP
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

// A rule that evaluates a KPI's data points and raises Alerts when breached.
// `config` is a ruleType-specific JSON blob validated by a Zod discriminated
// union in packages/contracts. P4 fully implements STATIC_THRESHOLD + NO_DATA;
// the other types accept config but their evaluators return false (P5 finishes).
model AlertRule {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kpiId          String
  name           String
  description    String?
  ruleType       AlertRuleType
  config         Json
  severity       AlertSeverity @default(MEDIUM)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String

  escalationRule EscalationRule?
  alerts         Alert[]

  @@index([kpiId, isActive])
  @@index([organizationId, isActive])
}

// Multi-level escalation policy for an alert rule. `levels` is an ordered JSON
// array: [{delayMinutes, channelIds[], notifyRoleIds[], notifyUserIds[]}, ...].
model EscalationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertRuleId    String       @unique
  alertRule      AlertRule    @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  levels         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// A raised alert instance. `alertRuleId` is null for ad-hoc alerts (e.g. P5
// anomaly confirms). `targetUserId` scopes PER_USER KPI alerts to one user.
model Alert {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertRuleId      String?
  alertRule        AlertRule?    @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  kpiId            String
  message          String
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  targetUserId     String?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  meta             Json?
  createdAt        DateTime      @default(now())

  deliveries NotificationDelivery[]

  @@index([organizationId, status, createdAt])
  @@index([kpiId, status])
  @@index([alertRuleId])
}

// A configured delivery target. `config` holds AES-256-GCM-encrypted credentials
// (SMTP/Slack webhook/Twilio/etc.); IN_APP needs none.
model NotificationChannel {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           NotificationChannelKind
  config         Json
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, isActive])
}

// One delivery attempt record for an alert through a channel (or IN_APP when
// channelId is null). Drives the retry queue + DLQ admin views.
model NotificationDelivery {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertId        String
  alert          Alert                      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channelId      String?
  targetUserId   String?
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())

  @@index([alertId])
  @@index([organizationId, status, createdAt])
  @@index([targetUserId, status])
}

// An outbound webhook subscription. `secret` (prefix whsec_) signs payloads
// with HMAC-SHA256. Auto-disabled after sustained failures.
model WebhookSubscription {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  url             String
  events          String[]
  secret          String
  isActive        Boolean      @default(true)
  lastDeliveredAt DateTime?
  lastStatus      Int?
  failureCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  createdById     String

  @@index([organizationId, isActive])
}

// A hashed API key for programmatic access. Plaintext (kpinx_*) is shown once.
// `scopes` restrict which permissions the key grants (admin bypass disabled).
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  hashedKey      String       @unique
  keyPrefix      String
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  createdById    String

  @@index([organizationId, revokedAt])
}

// ============================================================================
// P2.x — KPI targets (build backlog; deferred from initial P2)
// ============================================================================

enum KPITargetType {
  STATIC
  TIERED
  DYNAMIC
  TIME_VARYING
  CONDITIONAL
  SCENARIO
}

// A target/goal for a KPI. Type-specific fields are validated in the service
// (STATIC→value, TIERED/SCENARIO→bands, DYNAMIC→formula, TIME_VARYING→window,
// CONDITIONAL→metadata.condition). Scalar FKs (no Prisma relations) — queries
// are org-scoped explicitly.
model KPITarget {
  id              String        @id @default(cuid())
  organizationId  String
  kpiId           String
  type            KPITargetType @default(STATIC)
  value           Float?
  minValue        Float?
  expectedValue   Float?
  stretchValue    Float?
  impossibleValue Float?
  formula         String?
  metadata        Json?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  scenarioName    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String

  @@index([kpiId, type])
  @@index([kpiId, effectiveFrom])
  @@index([organizationId])
}

// ============================================================================
// P2.x — KPI threshold bands (build backlog; deferred from initial P2)
// ============================================================================

// Named status bands over a KPI's value range. A value falls in a band when it
// is within [lower, upper] (null bound = open-ended). `consecutivePointsRequired`
// drives hysteresis in the status resolver. Scalar FKs (org-scoped explicitly).
model KPIThresholdBand {
  id                        String   @id @default(cuid())
  organizationId            String
  kpiId                     String
  name                      String
  lower                     Float?
  upper                     Float?
  color                     String
  order                     Int
  consecutivePointsRequired Int      @default(1)
  createdAt                 DateTime @default(now())
  createdById               String

  @@index([kpiId, order])
  @@index([organizationId])
}

// ============================================================================
// P2.x — KPI benchmarks (build backlog; deferred from initial P2)
// ============================================================================

// Reference values a KPI is compared against. INTERNAL_HISTORICAL rows are
// computed by averaging recent data points; EXTERNAL_* rows are entered
// manually with a source. `kind` is a free string (INTERNAL_HISTORICAL |
// EXTERNAL_INDUSTRY | EXTERNAL_PEER) validated in the service. Scalar FKs
// (org-scoped explicitly).
model KPIBenchmark {
  id             String    @id @default(cuid())
  organizationId String
  kpiId          String
  kind           String
  value          Float
  periodStart    DateTime?
  periodEnd      DateTime?
  source         String?
  createdAt      DateTime  @default(now())
  createdById    String

  @@index([kpiId, kind])
  @@index([organizationId])
}

// ============================================================================
// P2.x — KPI templates (build backlog; deferred from initial P2)
// ============================================================================

// Starter KPI definitions browsable in a gallery and instantiable into an org.
// `organizationId` null = global/builtin template (visible to all tenants);
// non-null = org-private template. Relevance ranking + filtering happens in the
// service (in-memory; PG FTS deferred to P9).
model KPITemplate {
  id                String             @id @default(cuid())
  organizationId    String?
  slug              String             @unique
  name              String
  description       String?
  type              KPIType
  direction         KPIDirection
  frequency         KPIFrequency
  aggregationMethod AggregationMethod?
  scorecardQuadrant String?
  function          String?
  industry          String?
  unit              String?
  unitConfig        Json?
  targetSummary     String?
  tags              String[]
  popularity        Int                @default(0)
  isGlobal          Boolean            @default(false)
  isBuiltin         Boolean            @default(false)
  createdAt         DateTime           @default(now())

  @@index([function])
  @@index([scorecardQuadrant])
  @@index([industry])
  @@index([popularity(sort: Desc)])
}

// ============================================================================
// P2.x — Data lineage (build backlog; deferred from initial P2)
// ============================================================================

// A directed edge in the data-lineage graph: source feeds/produces target via
// some transform (FORMULA | CASCADE_ROLLUP | INGEST | MANUAL_ADJUST). Types are
// free strings ("kpi" | "data_point" | "ingestion_job" | ...). Recorded
// fire-and-forget; traversed via in-memory BFS. Scalar FKs (org-scoped).
model LineageEdge {
  id             String   @id @default(cuid())
  organizationId String
  sourceType     String
  sourceId       String
  targetType     String
  targetId       String
  transformType  String
  jobRunId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, targetType, targetId])
  @@index([organizationId, createdAt])
}

// ============================================================================
// P2.x — Formula persistence + dependency DAG (build backlog; calc-engine)
// ============================================================================

// One persisted formula per KPI. `raw` is the source text evaluated by the
// formula engine; `ast` is the parsed tree used to extract referenced KPI
// identifiers into KPIDependency edges. `compiledSql` is reserved (PG pushdown,
// unused at FYP scale). Scalar FKs (org-scoped explicitly).
model FormulaExpression {
  id             String   @id @default(cuid())
  organizationId String
  kpiId          String   @unique
  raw            String
  ast            Json
  compiledSql    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// A directed edge in the formula dependency DAG: `dependentKpiId`'s formula
// references `sourceKpiId`. Rebuilt on every formula attach. Drives reactive
// recompute ordering. Scalar FKs (org-scoped explicitly).
model KPIDependency {
  id             String   @id @default(cuid())
  organizationId String
  sourceKpiId    String
  dependentKpiId String
  formulaRef     String?
  createdAt      DateTime @default(now())

  @@unique([sourceKpiId, dependentKpiId])
  @@index([organizationId, sourceKpiId])
  @@index([organizationId, dependentKpiId])
}

// ============================================================================
// P5 — AI layer: provider config, per-feature routing, call log, budget caps
// ============================================================================

enum AiProviderKey {
  CLAUDE
  GEMINI
  OPENAI
  OLLAMA
}

enum AiCallStatus {
  SUCCESS
  FAILED
  SUPPRESSED
}

enum CircuitBreakerMode {
  FAIL_CLOSED
  FALLBACK
}

// A configured AI provider for an org. `encryptedCredentials` holds the
// AES-256-GCM envelope for a bring-your-own key (null = use the platform key).
// Scalar FK (org-scoped explicitly).
model AiProvider {
  id                   String        @id @default(cuid())
  organizationId       String
  key                  AiProviderKey
  displayName          String
  isEnabled            Boolean       @default(true)
  encryptedCredentials Json?
  supportedFeatures    String[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Per-org override of which provider+model serves a given AiFeature, with an
// optional fallback and per-feature spend cap. Unconfigured features fall back
// to DEFAULT_FYP_CONFIG in code. Scalar FK (org-scoped explicitly).
model AiFeatureConfig {
  id                 String   @id @default(cuid())
  organizationId     String
  feature            String
  providerId         String
  model              String
  fallbackProviderId String?
  fallbackModel      String?
  perFeatureCapUsd   Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([organizationId, feature])
  @@index([organizationId])
}

// Append-only ledger of every AI provider call for cost attribution + audit.
// Scalar FK (org-scoped explicitly).
model AiCallLog {
  id             String        @id @default(cuid())
  organizationId String
  feature        String
  providerKey    AiProviderKey
  modelId        String
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  costUsd        Float         @default(0)
  latencyMs      Int           @default(0)
  status         AiCallStatus
  errorCode      String?
  requestId      String
  context        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, feature, createdAt])
  @@index([requestId])
}

// One budget row per org. Redis holds the live rolling counters; this row is
// the durable source of truth for caps + the persisted spend snapshot.
model AiBudget {
  id                  String             @id @default(cuid())
  organizationId      String             @unique
  dailyCapUsd         Float              @default(1.0)
  monthlyCapUsd       Float              @default(30.0)
  circuitBreaker      CircuitBreakerMode @default(FAIL_CLOSED)
  currentDailySpend   Float              @default(0)
  currentMonthlySpend Float              @default(0)
  dailyPeriodStart    DateTime           @default(now())
  monthlyPeriodStart  DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ============================================================================
// P5 — AI insights + recommendations (anomaly/forecast/NLQ models land later)
// ============================================================================

enum RecommendationStatus {
  PENDING
  ACTIONED
  DISMISSED
}

// An AI-generated narrative about a KPI's recent trend. Scalar FK (org-scoped).
model KPIInsight {
  id               String    @id @default(cuid())
  organizationId   String
  kpiId            String
  narrative        String
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  // Derived 0..1 confidence (data volume + recency + change magnitude).
  confidence       Float     @default(0.5)
  generatedAt      DateTime  @default(now())
  // Lifecycle: ACTIVE by default; an operator can DISMISS an insight to hide it.
  status           String    @default("ACTIVE")
  dismissedAt      DateTime?
  dismissedById    String?

  @@index([organizationId, generatedAt])
  @@index([kpiId, generatedAt])
  @@index([organizationId, status])
}

// An AI recommendation triggered by an alert/anomaly or requested manually.
// `content` holds {summary, rootCauseHypotheses[], suggestedActions[]}. Scalar
// FK (org-scoped explicitly).
model Recommendation {
  id             String               @id @default(cuid())
  organizationId String
  kpiId          String
  alertId        String?
  anomalyId      String?
  content        Json
  confidence     Float
  status         RecommendationStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  @@index([organizationId, status])
  @@index([kpiId, status])
  @@index([alertId])
}

// ============================================================================
// P5 — NLQ: KPI catalog embeddings (pgvector) + question log
// ============================================================================

// One embedding row per (kpi, provider). Vectors are stored per-provider so
// switching the embedding provider only back-fills a new column (no migration).
// The vector columns are pgvector `Unsupported` types — written/searched via
// raw SQL; scalar fields use the Prisma client. Scalar FK (org-scoped).
model KpiCatalogEmbedding {
  id               String                        @id @default(cuid())
  organizationId   String
  kpiId            String
  embedding_openai Unsupported("vector(1536)")?
  embedding_gemini Unsupported("vector(768)")?
  embedding_voyage Unsupported("vector(1024)")?
  sourceText       String
  providerKey      AiProviderKey
  generatedAt      DateTime                      @default(now())

  @@unique([kpiId, providerKey])
  @@index([organizationId])
}

// Audit + analytics log of every NLQ question. `response` is {answer, sources,
// chartSpec?}. Scalar FK (org-scoped explicitly).
model NLQQuery {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  question       String
  response       Json
  latencyMs      Int           @default(0)
  costUsd        Float         @default(0)
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  providerKey    AiProviderKey
  modelId        String
  status         AiCallStatus
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

// ============================================================================
// P5 — ML sidecar persistence: anomaly detections + forecasts
// ============================================================================

enum ForecastModelKind {
  PROPHET
  ARIMA
  NAIVE
  LSTM
}

// A detected anomaly for a KPI data point. `score` is the detector's anomaly
// score; `method` is the algorithm (ISOLATION_FOREST | ZSCORE | EWMA | ENSEMBLE).
// Confirming one fires a recommendation + synthetic alert. Scalar FK (org-scoped).
model AnomalyDetection {
  id             String   @id @default(cuid())
  organizationId String
  kpiId          String
  dataPointId    String?
  score          Float
  method         String
  isConfirmed    Boolean  @default(false)
  detectedAt     DateTime @default(now())

  @@index([organizationId])
  @@index([kpiId, detectedAt])
  @@index([kpiId, isConfirmed])
}

// A stored forecast for a KPI. `predictions` is [{ds, yhat, yhat_lower_80,
// yhat_upper_80, yhat_lower_95, yhat_upper_95}]; `fitMetrics` is {rmse, mape}.
// Scalar FK (org-scoped explicitly).
model Forecast {
  id             String            @id @default(cuid())
  organizationId String
  kpiId          String
  horizon        Int
  model          ForecastModelKind
  predictions    Json
  fitMetrics     Json?
  generatedAt    DateTime          @default(now())

  @@index([organizationId, kpiId, generatedAt])
}

// ============================================================================
// P6 — Onboarding 2.0: sessions, AI interactions, org templates, setup checklist
// ============================================================================

enum OnboardingStatus {
  in_progress
  completed
  archived
}

enum OnboardingAiMode {
  generator
  assistant
  suggest
  explain
}

// A draft onboarding session. `organizationId` is null until completed (the org
// is materialized at the end). `payload` is the entire draft state; resumable
// via `draftTokenHash` (HMAC of session id + secret) before auth exists.
model OnboardingSession {
  id               String           @id @default(cuid())
  organizationId   String?
  organizationName String
  userId           String?
  userEmail        String
  draftTokenHash   String?
  payload          Json
  status           OnboardingStatus @default(in_progress)
  entryMode        String           @default("full")
  lastEditedStep   String?
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  updatedAt        DateTime         @updatedAt

  @@index([userEmail, status])
}

// Audit + analytics of every AI co-pilot interaction during onboarding.
model OnboardingAIInteraction {
  id               String           @id @default(cuid())
  sessionId        String
  mode             OnboardingAiMode
  prompt           String
  response         String
  appliedSections  String[]
  editedSections   String[]
  rejectedSections String[]
  promptTokens     Int              @default(0)
  completionTokens Int              @default(0)
  latencyMs        Int
  providerKey      String?
  modelId          String?
  costUsd          Float?
  createdAt        DateTime         @default(now())

  @@index([sessionId, createdAt])
}

// A reusable org template (builtin when organizationId is null). `payload` holds
// roles + positions + units + categories + KPIs to seed a new org.
model OrgTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  slug           String   @unique
  name           String
  description    String?
  tier           String   @default("starter")
  orgType        String?
  industry       String?
  payload        Json
  isBuiltin      Boolean  @default(false)
  isPublic       Boolean  @default(false)
  popularity     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([tier])
  @@index([industry])
}

// A post-onboarding setup-checklist task. Lazily upserted: fresh orgs see 14
// pending defaults without rows until a status changes. Scalar FK (org-scoped).
model OnboardingTask {
  id             String    @id @default(cuid())
  organizationId String
  key            String
  status         String    @default("pending")
  dueAt          DateTime?
  completedAt    DateTime?
  completedById  String?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, key])
  @@index([organizationId])
}

// ============================================================================
// P7 — Collaboration & Workflow: tasks, comments, mentions, OKRs, approvals,
// generic rule engine. All scalar FKs (org-scoped explicitly per convention).
// ============================================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ObjectiveStatus {
  DRAFT
  ACTIVE
  AT_RISK
  ACHIEVED
  MISSED
  ARCHIVED
}

enum ApprovalEntityType {
  KPI_DEFINITION
  KPI_TARGET
  ROLE_PERMISSIONS
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// An actionable task, optionally tied to a KPI or an alert. Status lifecycle:
// TODO → IN_PROGRESS → BLOCKED/DONE/CANCELLED.
model Task {
  id             String       @id @default(cuid())
  organizationId String
  kpiId          String?
  alertId        String?
  title          String
  description    String?
  assigneeUserId String?
  dueAt          DateTime?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  externalRef    String? // Jira link, etc.
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([organizationId, kpiId])
  @@index([organizationId, assigneeUserId, status])
}

// A threaded comment on any entity (kpi/dashboard/alert/task/objective).
// `mentionedUserIds` is denormalized; canonical inbox rows live in Mention.
model Comment {
  id               String    @id @default(cuid())
  organizationId   String
  entityType       String // "kpi" | "dashboard" | "alert" | "task" | "objective"
  entityId         String
  parentCommentId  String? // threading
  authorId         String
  body             String    @db.Text
  mentionedUserIds String[]
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([parentCommentId])
}

// A per-user mention inbox row, created in the same transaction as its Comment.
model Mention {
  id              String    @id @default(cuid())
  organizationId  String
  commentId       String
  mentionedUserId String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([organizationId, mentionedUserId, readAt])
}

// An OKR objective. `parentObjectiveId` forms the alignment tree; `progress` is
// 0-1, recomputed from key results + child objectives.
model Objective {
  id                String          @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  ownerUserId       String
  parentObjectiveId String? // alignment graph
  periodStart       DateTime
  periodEnd         DateTime
  status            ObjectiveStatus @default(DRAFT)
  progress          Float           @default(0) // 0-1
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([parentObjectiveId])
  @@index([ownerUserId])
}

// A key result under an objective. Optional `kpiId` link drives auto-progress.
model KeyResult {
  id             String   @id @default(cuid())
  organizationId String
  objectiveId    String
  name           String
  description    String?
  kpiId          String? // optional KPI link for auto-progress
  baselineValue  Float?
  targetValue    Float
  currentValue   Float?
  weight         Float    @default(1.0)
  progress       Float    @default(0) // 0-1
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([objectiveId])
  @@index([kpiId])
}

// Per-entity-type approval gate config (one active workflow per type per org).
model ApprovalWorkflow {
  id                      String             @id @default(cuid())
  organizationId          String
  entityType              ApprovalEntityType
  requiredApproverRoleIds String[]
  requireAll              Boolean            @default(false)
  isActive                Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([organizationId, entityType])
}

// A pending mutation captured by an active approval workflow. `proposedPayload`
// is replayed by ApprovalApplyService once approved. `decisions` is
// [{userId, decision, comment, decidedAt}].
model ApprovalRequest {
  id              String                @id @default(cuid())
  organizationId  String
  workflowId      String
  entityType      ApprovalEntityType
  entityId        String
  requesterUserId String
  proposedPayload Json
  // Snapshot of the entity's state BEFORE the proposed change (null for creates)
  // so the approver UI can render a before→after diff.
  currentPayload  Json?
  status          ApprovalRequestStatus @default(PENDING)
  decisions       Json                  @default("[]")
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status, createdAt])
}

// A generic if-this-then-that automation. `triggers` is string[] of
// kpi_changed/schedule/alert/manual; `rule` and `action` are JSON (see
// rule-evaluator.ts / action-dispatcher.ts for shapes).
model Workflow {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  triggers       String[]
  rule           Json?
  action         Json
  isActive       Boolean   @default(true)
  scheduleCron   String?
  lastRunAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, isActive])
}

// ============================================================================
// P8 — Integrations & Extensibility: connections, connectors, pipelines,
// ingestion jobs, plugins. All scalar FKs (org-scoped explicitly per convention).
// ============================================================================

enum IntegrationConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
}

enum ConnectorType {
  REST
  GRAPHQL
  POSTGRES
  MYSQL
  S3
  GCS
  WEBHOOK
}

enum PipelineStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

enum PluginType {
  WIDGET
  TEMPLATE
  FORMULA_FN
  CONNECTOR
}

// A connected third-party provider (Slack/Teams/Jira/…). `encryptedTokens`
// holds an AES-256-GCM ciphertext blob — never logged, redacted from audit.
model IntegrationConnection {
  id              String                      @id @default(cuid())
  organizationId  String
  provider        String
  displayName     String?
  encryptedTokens Json
  scopes          String[]
  status          IntegrationConnectionStatus @default(PENDING)
  lastSyncAt      DateTime?
  lastError       String?
  metadata        Json?
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([organizationId, provider])
}

// A scheduled data pull (REST/GraphQL/Postgres/…). `config` shape depends on
// `type`; see the matching runner in connectors/runners/.
model Connector {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  type           ConnectorType
  config         Json
  schedule       String?
  isActive       Boolean       @default(true)
  lastRunAt      DateTime?
  lastRunStatus  String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, isActive])
}

// A transform/filter/load pipeline attached to a connector (transform stage
// deferred post-P9; P8 uses source → load via valuePath extraction).
model Pipeline {
  id             String         @id @default(cuid())
  organizationId String
  connectorId    String
  name           String
  steps          Json
  status         PipelineStatus @default(IDLE)
  lastRunAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([connectorId])
}

// Audit row for every ingestion (CSV/JSON/webhook/connector). `source` carries
// {label, apiKeyId?, connectorId?, rowCount}.
model IngestionJob {
  id             String    @id @default(cuid())
  organizationId String
  kind           String
  source         Json
  status         String
  startedAt      DateTime
  finishedAt     DateTime?
  errorLog       String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
}

// A registered extension (widget/template/formula-fn/connector). P8 catalogs
// installs; iframe sandbox execution lands in P9.
model Plugin {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  type           PluginType
  version        String
  entryUrl       String
  description    String?
  isEnabled      Boolean    @default(true)
  config         Json?
  installedById  String
  createdAt      DateTime   @default(now())

  @@index([organizationId, type, isEnabled])
}

// ============================================================================
// P9 — Polish: SSO (SAML/OIDC) + SCIM provisioning tokens.
// ============================================================================

enum SsoProtocol {
  SAML
  OIDC
}

// One SSO config per org. `encryptedCertificate` (SAML X.509) is sealed with the
// integration crypto key. JIT provisioning auto-creates users on first login.
model SsoConfig {
  id                   String      @id @default(cuid())
  organizationId       String      @unique
  protocol             SsoProtocol
  idpEntityId          String?
  idpSsoUrl            String?
  idpMetadataUrl       String?
  encryptedCertificate String?
  allowJitProvisioning Boolean     @default(true)
  defaultRoleId        String?
  isActive             Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// A bearer token an IdP (Okta/Azure AD) uses against /scim/v2. Stored hashed.
model ScimToken {
  id             String    @id @default(cuid())
  organizationId String
  label          String
  hashedToken    String    @unique
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([organizationId, revokedAt])
}
