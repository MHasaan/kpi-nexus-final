{
  "name": "@kpi-nexus/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./tailwind-preset": {
      "types": "./tailwind.preset.ts",
      "import": "./tailwind.preset.ts"
    }
  },
  "files": ["dist", "src", "tailwind.preset.ts"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@kpi-nexus/config": "workspace:*",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
